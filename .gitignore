# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Type checking / linting caches
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/

# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local logs and generated reports
*.log
output/*
!output/.gitkeep

# Temporary files
*.tmp
*.temp
*.bak
