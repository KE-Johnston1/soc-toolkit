`comment(AUTH-REPEAT-001 | MITRE ATT&CK T1110.003 Password Spraying)`
index=* sourcetype=linux_secure ("Failed password" OR "authentication failure" OR "Failed publickey")
| rex field=_raw "from (?<src_ip>[0-9A-Fa-f:.]+)"
| rex field=_raw "for (?:invalid user )?(?<account>[^ ]+)"
| where isnotnull(src_ip) AND isnotnull(account)
| bin _time span=5m
| stats count as failure_count dc(account) as account_count earliest(_time) as first_seen latest(_time) as last_seen by src_ip, _time
| where failure_count >= 5 AND account_count >= 2
| eval rule_id="AUTH-REPEAT-001", attack_technique="T1110.003", assessment="Requires Investigation", confidence="Medium"
| table _time src_ip account_count failure_count first_seen last_seen rule_id attack_technique assessment confidence
