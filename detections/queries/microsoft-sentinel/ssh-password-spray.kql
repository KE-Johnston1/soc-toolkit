// AUTH-REPEAT-001 | MITRE ATT&CK T1110.003 Password Spraying
// Investigation lead: repeated SSH failures from one source across multiple accounts.
// Adapt table/field names to the deployed data connector.
Syslog
| where Facility == "auth" or ProcessName in~ ("sshd", "ssh")
| where SyslogMessage has_any ("Failed password", "authentication failure", "Failed publickey")
| extend SourceIP = extract(@"from ([0-9a-fA-F:.]+)", 1, SyslogMessage),
         Account = extract(@"for (?:invalid user )?([^ ]+)", 1, SyslogMessage)
| where isnotempty(SourceIP) and isnotempty(Account)
| summarize FailureCount=count(), AccountCount=dcount(Account), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by SourceIP, bin(TimeGenerated, 5m)
| where FailureCount >= 5 and AccountCount >= 2
| extend RuleId="AUTH-REPEAT-001", ATTACK="T1110.003", Assessment="Requires Investigation", Confidence="Medium"
| project TimeGenerated, SourceIP, AccountCount, FailureCount, FirstSeen, LastSeen, RuleId, ATTACK, Assessment, Confidence
